# Copy to .env and fill in. .env is gitignored; this file is not.
# Where each value comes from is in the README, under Setup.

GEMINI_API_KEY=          # the writer
GROQ_API_KEY=            # the fact-checker and the news agent

ESPN_S2=                 # cookies from espn.com while logged in
ESPN_SWID=               # keep the curly braces: {ABC-123-...}
ESPN_LEAGUE_ID=          # from your team page address: ...?leagueId=...
ESPN_TEAM_ID=            # ...&teamId=...

RESEND_API_KEY=          # sends the email
EMAIL_TO=                # must be your Resend account's address until you verify a domain
